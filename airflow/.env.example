# Copy to airflow/.env and fill in. airflow/.env is git-ignored: never commit it.
#   cp airflow/.env.example airflow/.env
#   python scripts/generate_secrets.py      (fills the AIRFLOW_*_KEY/SECRET lines)

# Linux/WSL: your user id (`id -u`), so files Airflow writes belong to you. Windows: 50000
AIRFLOW_UID=50000

# Database for Airflow and the pipeline
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# Free key from https://twelvedata.com
TWELVE_DATA_API_KEY=

# Airflow internal secrets: generated, don't type them by hand
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# Optional: AWS (phase 7), streaming and Grafana settings
# LAKE_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# STREAM_MODE=replay
# GRAFANA_ADMIN_PASSWORD=
